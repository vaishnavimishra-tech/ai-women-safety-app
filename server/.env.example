PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/womensafety

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional
# SMS_MODE=demo            # force demo mode (logs SMS instead of sending)
# DEFAULT_COUNTRY_CODE=+91 # added to numbers saved without a country code
# SMS_TIMEOUT_MS=10000
